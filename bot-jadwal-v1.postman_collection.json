    {
      "name": "02. Mahasiswa (Portal Publik)",
      "description": "Endpoint akses publik hanya-baca (read-only) untuk mahasiswa melalui tautan kelas permanen. Tidak memerlukan header Authorization.",
      "item": [
        {
          "name": "[Portal] Ringkasan Hari Ini (Summary)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status kode 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Payload summary kelas valid\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"success\");",
                  "    pm.expect(json.data.class).to.eql(pm.collectionVariables.get(\"classSlug\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/portal/{{classSlug}}/summary?date=2026-09-28",
