            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            },
            "description": "PJ langsung memublikasikan tugas ke portal mahasiswa. Tugas otomatis berstatus NOT_REVIEWED untuk ditinjau KM."
          }
        },
