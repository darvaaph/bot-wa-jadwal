  "item": [
    {
      "name": "01. Otentikasi & Akun",
      "description": "Pengelolaan sesi pengurus berbasis token Bearer buram (opaque token), rotasi sesi, dan manajemen undangan.",
      "item": [
        {
          "name": "[Auth] Login KM (Ketua Murid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status kode 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token Bearer KM tersimpan otomatis\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"success\");",
                  "    pm.expect(json.data.token).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"token\", json.data.token);",
                  "    pm.collectionVariables.set(\"tokenKM\", json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity_key\": \"+6281234567890\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login sebagai Ketua Murid (KM). Token otomatis tersimpan ke variabel {{token}} dan {{tokenKM}}."
          }
        },
        {
          "name": "[Auth] Login PJ (Penanggung Jawab)",
