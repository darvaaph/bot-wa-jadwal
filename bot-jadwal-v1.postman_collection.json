          "name": "[PJ] Terbitkan Tugas (Publish)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status kode 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Tugas terbit dan butuh review KM\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.publication_status).to.eql(\"PUBLISHED\");",
                  "    pm.collectionVariables.set(\"currentTaskId\", String(json.data.id));",
                  "});"
