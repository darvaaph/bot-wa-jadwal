    {
      "name": "03. PJ Mata Kuliah (Pengelolaan Tugas & Sesi)",
      "description": "Aktivitas operasional Penanggung Jawab (PJ) mata kuliah: mengelola tugas matkulnya, mengajukan jadwal pengganti, dan menambah materi pendukung.",
      "item": [
        {
          "name": "[PJ] Simpan Draf Tugas Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status kode 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Draf berhasil dibuat\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.publication_status).to.eql(\"DRAFT\");",
                  "    pm.collectionVariables.set(\"currentTaskId\", String(json.data.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offering_id\": 1,\n  \"title\": \"Draf Latihan Soal Nilai Eigen\",\n  \"instructions\": \"Instruksi sementara akan dilengkapi setelah jam kuliah\",\n  \"deadline_at\": \"2026-10-15T16:59:00Z\",\n  \"save_as\": \"draft\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            },
            "description": "PJ menyimpan catatan tugas sebagai draf (belum terlihat di portal mahasiswa)."
          }
        },
