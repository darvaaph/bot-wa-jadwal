# ==============================================================================
# BOT JADWAL v3.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env di server produksi / staging:
#   cp .env.example .env
# PERINGATAN: JANGAN PERNAH MENYIMPAN / MENGIKUTKAN FILE .env NYATA KE DALAM GIT!
# ==============================================================================

# [Mode Lingkungan]
# Pilihan: development | test | production
# Pada mode production, server akan menolak startup jika proteksi keamanan tidak lengkap.
BOT_JADWAL_ENV=production

# [Port HTTP REST API & Web Dashboard]
PORT=8080

# [Direktori Penyimpanan Database & Sesi]
# Direktori ini harus memiliki hak akses baca & tulis oleh user sistem (misal: botuser).
STORAGE_DIR=storage

# [Kunci Hash Otentikasi & Enkripsi Sesi]
# Wajib minimal 32 karakter acak (256-bit) di mode production.
# Contoh pembuatan kunci di terminal Linux:
#   openssl rand -hex 32
BOT_JADWAL_AUTH_HASH_KEY=ganti_dengan_minimal_32_karakter_acak_hex_rahasia_anda_di_sini

# [Keamanan Cookie Sesi]
# Wajib 'true' pada production agar cookie hanya dikirim melalui koneksi terenkripsi HTTPS.
BOT_JADWAL_SECURE_COOKIES=true

# [URL Publik Aplikasi]
# URL resmi yang dapat diakses pengguna (wajib HTTPS murni tanpa path atau trailing slash).
BOT_JADWAL_PUBLIC_BASE_URL=https://jadwal.jurusan-anda.ac.id

# [CORS Allowed Origins]
# Daftar domain yang diizinkan memanggil API web (pisahkan dengan koma jika lebih dari satu).
# Wajib mencantumkan BOT_JADWAL_PUBLIC_BASE_URL.
BOT_JADWAL_ALLOWED_ORIGINS=https://jadwal.jurusan-anda.ac.id

# [IP Proxy Terpercaya (Reverse Proxy Nginx / Caddy / Cloudflare)]
# CIDR subnet atau IP proxy lokal yang meneruskan traffic ke aplikasi Go.
# Digunakan untuk membaca IP asli pengguna secara aman tanpa risiko IP Spoofing.
BOT_JADWAL_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# [Password Inisialisasi System Admin Pertama]
# Hanya digunakan saat menjalankan utilitas provisioning: go run ./cmd/provision-admin
# Kosongkan atau hapus dari memori setelah akun admin awal berhasil dibuat.
BOT_JADWAL_ADMIN_PASSWORD=
